# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already listed in .gitignore.

# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
# Local example:   mongodb://127.0.0.1:27017/flowcut
# Atlas example:   mongodb+srv://<user>:<password>@<cluster-url>/flowcut?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Generate a real random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- CORS ----
# The URL your Vite frontend runs on.
CORS_ORIGIN=http://localhost:5173

# ---- Gmail OTP delivery ----
# Use a Gmail app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Initial Super Admin (used only by the seed script, see README) ----
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PASSWORD=

# ---- Development test accounts (Phase 4 - used only by `npm run seed`) ----
# Optional: if left blank, the seed script skips creating that account.
# Format for all mobile numbers: 09XXXXXXXXX (Philippine format).
TEST_CUSTOMER_NAME=
TEST_CUSTOMER_LAST_NAME=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_MOBILE=
TEST_CUSTOMER_PASSWORD=

TEST_SHOP_NAME=
TEST_SHOP_ADMIN_NAME=
TEST_SHOP_ADMIN_EMAIL=
TEST_SHOP_ADMIN_MOBILE=
TEST_SHOP_ADMIN_PASSWORD=

TEST_BARBER_NAME=
TEST_BARBER_EMAIL=
TEST_BARBER_MOBILE=
TEST_BARBER_PASSWORD=
