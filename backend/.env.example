# Required for the API to start. Replace every placeholder before use.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Backend-enforced authenticated session limits.
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30
AUTH_SESSION_MAX_LIFETIME_DAYS=7

# Optional Analytics Assistant settings. Keep the API key backend-only.
GEMINI_API_KEY=replace-with-a-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
# App safeguards; these are FlowCut limits, not Google's project quotas.
# Defaults preserve the previous 24 chat + 8 insights requests per 15 minutes for one shop.
GEMINI_LIMIT_WINDOW_MINUTES=15
GEMINI_USER_LIMIT_MAX=24
GEMINI_APP_LIMIT_MAX=32
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_CONCURRENCY_LEASE_SECONDS=90
